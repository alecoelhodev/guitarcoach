# Copy to .env and fill in real values. Never commit .env.

# --- Application (validated in src/config/env.validation.ts) ---
NODE_ENV=development
PORT=3000
API_PREFIX=api
API_VERSION=v1

# --- PostgreSQL container (postgres:17-alpine, provisioned in compose.yaml) ---
# NOTE: no database client/ORM is installed in package.json yet — these variables
# only configure the Postgres container itself and are not read by the API today.
POSTGRES_USER=guitar_coach
POSTGRES_PASSWORD=change-me
POSTGRES_DB=guitar_coach
# Host port Postgres is published on in compose.dev.yaml (not exposed in prod).
POSTGRES_PORT=5432

# Copy to .env and fill in real values. Never commit .env.

# --- Application (validated in src/config/env.validation.ts) ---
NODE_ENV=development
PORT=3000
API_PREFIX=api
API_VERSION=v1

# GET /health/ready's memory_heap / memory_rss Terminus thresholds, in bytes.
# Both default to 300MB (300*1024*1024), calibrated for the compiled
# production build. compose.dev.yaml overrides HEALTH_MEMORY_RSS_THRESHOLD_BYTES
# to 1GiB since `nest start --watch`'s dev-mode compiler runs well above 300MB
# RSS during its first couple minutes after boot; uncomment below only if
# running outside Docker Compose and hitting the same false positive.
# HEALTH_MEMORY_HEAP_THRESHOLD_BYTES=314572800
# HEALTH_MEMORY_RSS_THRESHOLD_BYTES=314572800

# Minimum level emitted by StructuredLoggerService (src/observability/).
# One of: verbose, debug, log, warn, error, fatal.
LOG_LEVEL=log
# Whether OTel metrics (src/observability/metrics/) export to GCP Cloud
# Monitoring. Leave false for local/dev/test — only set to true where the
# runtime has a GCP service account with roles/monitoring.metricWriter (see
# compose.prod.yaml / Cloud Run).
METRICS_EXPORT_ENABLED=false

# --- PostgreSQL container (postgres:17-alpine, provisioned in compose.yaml) ---
POSTGRES_USER=guitar_coach
POSTGRES_PASSWORD=change-me
POSTGRES_DB=guitar_coach
# Host port Postgres is published on in compose.dev.yaml (not exposed in prod).
POSTGRES_PORT=5432

# --- Redis container (redis:8-alpine, provisioned in compose.yaml) ---
# Host port Redis is published on in compose.dev.yaml (not exposed in prod).
REDIS_PORT=6379
# Used by the API to connect to Redis for response caching. When running via
# `docker compose` this is overridden to point at the `redis` service instead
# of localhost — see compose.yaml.
REDIS_URL="redis://localhost:${REDIS_PORT}"
# TTL for cached GET /tasks and GET /tasks/:id responses, in milliseconds.
# Must be between 60000 (1 min) and 600000 (10 min).
CACHE_TTL_MS=300000

# --- RabbitMQ container (rabbitmq:4-management-alpine, provisioned in compose.yaml) ---
# RabbitMQ's default `guest`/`guest` account can only authenticate from
# localhost inside the container, so it won't work through the port mapping
# below — a real user/password is required.
RABBITMQ_USER=guitar_coach
RABBITMQ_PASSWORD=change-me
# Host port RabbitMQ (AMQP) is published on in compose.dev.yaml (not exposed in prod).
RABBITMQ_PORT=5672
# Host port the management UI is published on in compose.dev.yaml (not exposed
# in prod). Once running, open http://localhost:${RABBITMQ_MANAGEMENT_PORT}
# and log in with RABBITMQ_USER / RABBITMQ_PASSWORD above.
RABBITMQ_MANAGEMENT_PORT=15672
# Used by the API to connect to RabbitMQ for publishing/consuming domain
# events. When running via `docker compose` this is overridden to point at
# the `rabbitmq` service instead of localhost — see compose.yaml.
RABBITMQ_URL="amqp://${RABBITMQ_USER}:${RABBITMQ_PASSWORD}@localhost:${RABBITMQ_PORT}"

# --- Prisma (validated in src/config/env.validation.ts) ---
# Used by the API and by the Prisma CLI (prisma.config.ts). Derived from
# POSTGRES_* above via dotenv-expand (expandVariables: true for the API,
# an explicit expand() call in prisma.config.ts for the CLI) — no need to
# keep this in sync by hand.
# When running via `docker compose` this is overridden to point at the
# `postgres` service instead of localhost — see compose.yaml.
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public"

# Used only by `npm run test:e2e` (test/support/global-setup.ts) to run e2e
# tests against a disposable database instead of your dev DATABASE_URL above.
# The database is created automatically if missing.
TEST_DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}_test?schema=public"

# --- Better Auth (validated in src/config/env.validation.ts) ---
# Generate a real secret locally with: openssl rand -base64 32
BETTER_AUTH_SECRET=REPLACE_WITH_OPENSSL_RAND_BASE64_32_OUTPUT_min_32_chars_long
BETTER_AUTH_URL=http://localhost:3000

# Browser origins allowed to send the session cookie — comma-separated, no wildcard.
# Validated in src/config/env.validation.ts, which parses it into a list that drives
# both enableCors() and Better Auth's own trustedOrigins check — without the latter,
# a request from the Expo web dev server passes CORS and then 403s as cross-origin.
# Native clients send no Origin header and need neither.
CORS_ORIGINS=http://localhost:8081

# --- GCP Cloud Storage (validated in src/config/env.validation.ts) ---
# Practice recordings are uploaded to a private GCS bucket; the API never
# makes it public. GOOGLE_APPLICATION_CREDENTIALS is read directly by the
# @google-cloud/storage client library via Application Default Credentials,
# not through ConfigService/env.validation.ts — set it to a local service
# account key file. In production (Cloud Run) leave it unset; the attached
# service account is used instead.
# Must be a fully-qualified path — it's read literally by Node, so shell
# shortcuts like `~/...` are NOT expanded and will fail with ENOENT.
GCP_PROJECT_ID=YOUR_PROJECT_ID
GCS_RECORDINGS_BUCKET=YOUR_BUCKET_NAME
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/guitar-coach-storage-dev.json
# If running via Docker Compose (see README > Local setup), the container
# can't see the host path above directly. Set this to the same absolute
# path on the HOST; compose.dev.yaml bind-mounts it read-only into the
# container and points GOOGLE_APPLICATION_CREDENTIALS at it for you there.
GCP_CREDENTIALS_HOST_PATH=/absolute/path/to/guitar-coach-storage-dev.json
# Max accepted upload size for a single practice recording, in bytes.
RECORDING_UPLOAD_MAX_SIZE_BYTES=52428800
# How long a GET .../download-url signed URL stays valid, in seconds.
RECORDING_DOWNLOAD_URL_EXPIRY_SECONDS=900

# --- AI Practice Planner (validated in src/config/env.validation.ts) ---
# OpenAI API key used by OpenAiResponsesService (Responses API). Never exposed
# to clients; read server-side only via ConfigService.
OPENAI_API_KEY=REPLACE_WITH_YOUR_OPENAI_API_KEY
# Model used for the Responses API calls (structured outputs, web_search,
# create_routine function tool). Not hardcoded in code — set the model you
# have access to, e.g. a current GPT model that supports the Responses API,
# structured outputs, and tool calling.
OPENAI_MODEL=gpt-4.1
# Per-request timeout (ms) for calls to the OpenAI Responses API.
OPENAI_REQUEST_TIMEOUT_MS=30000

# --- Weekly routine cleanup job (validated in src/weekly-routine-cleanup/env.validation.ts) ---
# Standalone Cloud Run Job (npm run weekly-routine-cleanup locally) that
# archives routines left `active` from before the current week. Only needs
# DATABASE_URL above plus the two vars below — it does not touch Redis,
# RabbitMQ, Better Auth, or GCS.
# IANA timezone used to compute "start of the current week" (Monday
# 00:00:00). No app-wide timezone is established elsewhere in this repo, so
# this defaults to UTC; only set it if you want the weekly boundary to align
# with a specific local timezone instead.
ROUTINE_CLEANUP_TIME_ZONE=UTC
# Manual-only override for the archiving cutoff (ISO 8601), for local testing
# or a one-off manual rerun with a specific boundary. Leave unset for normal/
# scheduled runs — do not set this in the deployed Cloud Run Job's env vars.
# CLEANUP_WEEK_START=2026-07-27T00:00:00Z

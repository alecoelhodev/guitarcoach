# Copy to .env and fill in real values. Never commit .env.

# --- Application (validated in src/config/env.validation.ts) ---
NODE_ENV=development
PORT=3000
API_PREFIX=api
API_VERSION=v1

# --- PostgreSQL container (postgres:17-alpine, provisioned in compose.yaml) ---
POSTGRES_USER=guitar_coach
POSTGRES_PASSWORD=change-me
POSTGRES_DB=guitar_coach
# Host port Postgres is published on in compose.dev.yaml (not exposed in prod).
POSTGRES_PORT=5432

# --- Prisma (validated in src/config/env.validation.ts) ---
# Used by the API and by the Prisma CLI (prisma.config.ts). Derived from
# POSTGRES_* above via dotenv-expand (expandVariables: true for the API,
# an explicit expand() call in prisma.config.ts for the CLI) — no need to
# keep this in sync by hand.
# When running via `docker compose` this is overridden to point at the
# `postgres` service instead of localhost — see compose.yaml.
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public"

# compiled output
/dist
/node_modules
/build

# Logs
logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# OS
.DS_Store

# Tests
/coverage
/.nyc_output

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# dotenv environment variable files
# Catch-all so a new variant (.env.staging, .env.prod, ...) cannot be committed
# by accident; .env.example is the one intentional exception.
.env
.env.*
!.env.example

# GCP service-account keys - referenced by GOOGLE_APPLICATION_CREDENTIALS,
# must never be committed.
*-service-account*.json
guitar-coach-storage-*.json

# temp directory
.temp
.tmp

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

/src/generated

# k6 performance-test output (JSON/HTML summaries), not committed
/k6/results/
*.k6-summary.json
*.k6-summary.html

# Pinned tooling downloaded by scripts/install-betterleaks.mjs
.tooling/

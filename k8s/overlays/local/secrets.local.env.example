# Copy to secrets.local.env (gitignored — never commit real values) and fill
# in real local values, then `kubectl apply -k k8s/overlays/local` creates
# the guitar-coach-secrets Secret from this file via kustomize's
# secretGenerator. Never commit actual secret values into Git.
#
# --- Raw credentials consumed directly by the postgres/rabbitmq containers ---
POSTGRES_USER=guitar_coach
POSTGRES_PASSWORD=change-me
POSTGRES_DB=guitar_coach
RABBITMQ_DEFAULT_USER=guitar_coach
RABBITMQ_DEFAULT_PASS=change-me

# --- Composed values consumed by the API/CronJob containers ---
# Kubernetes has no docker-compose-style ${VAR} interpolation, so these must
# be written out literally and kept in sync BY HAND with the raw credentials
# above (same user/password, host names matching the Service names:
# postgres, rabbitmq).
DATABASE_URL=postgresql://guitar_coach:change-me@postgres:5432/guitar_coach?schema=public
RABBITMQ_URL=amqp://guitar_coach:change-me@rabbitmq:5672

# Generate a real secret locally with: openssl rand -base64 32
BETTER_AUTH_SECRET=REPLACE_WITH_OPENSSL_RAND_BASE64_32_OUTPUT_min_32_chars_long

# A placeholder is fine if you don't need the AI practice-planner/routine
# coach features locally — see k8s/README.md's GCS/OpenAI limitation note.
OPENAI_API_KEY=REPLACE_WITH_YOUR_OPENAI_API_KEY_OR_A_PLACEHOLDER

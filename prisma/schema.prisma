// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../apps/guitar-coach/src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum RoutineStatus {
  active
  archived

  @@map("routine_status")
}

enum TaskCategory {
  technique
  theory
  repertoire

  @@map("task_category")
}

enum TaskDifficulty {
  easy
  medium
  hard

  @@map("task_difficulty")
}

model Task {
  id            String          @id @default(uuid()) @db.Uuid
  title         String          @db.VarChar
  category      TaskCategory?
  difficulty    TaskDifficulty?
  referenceLink String?         @map("reference_link")
  description   String?
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  routineTasks RoutineTask[]

  @@map("tasks")
}

model User {
  id            String    @id @default(uuid()) @db.Uuid
  displayName   String?   @db.VarChar
  email         String    @unique @db.VarChar
  emailVerified Boolean   @default(false) @map("email_verified")
  image         String?
  role          String    @default("user")
  banned        Boolean   @default(false)
  banReason     String?   @map("ban_reason")
  banExpires    DateTime? @map("ban_expires")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  routines Routine[]
  sessions Session[]
  accounts Account[]

  @@map("users")
}

model Session {
  id              String   @id @default(uuid()) @db.Uuid
  expiresAt       DateTime @map("expires_at")
  token           String   @unique
  ipAddress       String?  @map("ip_address")
  userAgent       String?  @map("user_agent")
  userId          String   @map("user_id") @db.Uuid
  impersonatedBy  String?  @map("impersonated_by")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Account {
  id                    String    @id @default(uuid()) @db.Uuid
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id") @db.Uuid
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@map("accounts")
}

model Verification {
  id         String    @id @default(uuid()) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime  @map("expires_at")
  createdAt  DateTime? @default(now()) @map("created_at")
  updatedAt  DateTime? @updatedAt @map("updated_at")

  @@map("verifications")
}

model Routine {
  id        String        @id @default(uuid()) @db.Uuid
  userId    String        @map("user_id") @db.Uuid
  title     String        @db.VarChar
  status    RoutineStatus @default(active)
  notes     String?
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  user         User          @relation(fields: [userId], references: [id])
  routineTasks RoutineTask[]

  @@map("routines")
}

model RoutineTask {
  routineId             String   @map("routine_id") @db.Uuid
  taskId                String   @map("task_id") @db.Uuid
  position              Int
  targetDurationMinutes Int?     @map("target_duration_minutes")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  routine Routine @relation(fields: [routineId], references: [id])
  task    Task    @relation(fields: [taskId], references: [id])

  @@id([routineId, taskId])
  @@unique([routineId, position])
  @@map("routine_tasks")
}
